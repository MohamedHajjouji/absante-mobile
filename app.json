{
  "expo": {
    "name": "AB Santé",
    "slug": "ab-sante-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "absante",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.absante.absante",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "AB Santé utilise votre galerie pour ajouter votre photo de profil et joindre des documents (ordonnances, factures).",
        "NSCameraUsageDescription": "AB Santé utilise votre appareil photo pour photographier des documents (ordonnances, reçus) à joindre à votre dossier.",
        "CFBundleLocalizations": ["fr", "en"]
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.absante.absante",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "@rnmapbox/maps"
    ],
    "experiments": {},
    "runtimeVersion": "1.0.0",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f031efc8-2944-412b-ab42-c3c2e1c56003"
      }
    },
    "owner": "mohamedhajjouji"
  }
}
